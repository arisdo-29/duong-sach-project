# Giữ định dạng giống nhau giữa IntelliJ, VS Code và Antigravity
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{java,xml}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[{*.cmd,*.bat}]
end_of_line = crlf
