# Mẫu cấu hình – copy thành .env rồi điền chuỗi thật. KHÔNG commit file .env.
# Chuỗi kết nối lấy từ Neon Console: chọn nhánh của bạn → nút Connect.
# Hướng dẫn chi tiết: docs/05-database-va-deploy.md mục 4.

# Prisma Client dùng khi chạy API.
# Máy dev: dùng chuỗi DIRECT của nhánh mình.
# Trên Vercel: dùng chuỗi POOLED (host có "-pooler") và thêm &pgbouncer=true
DATABASE_URL="postgresql://<user>:<matkhau>@<host>.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# Chuỗi kết nối TRỰC TIẾP (không pooling) – Prisma CLI dùng cho `prisma db push`
DIRECT_URL="postgresql://<user>:<matkhau>@<host>.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# Domain sinh URL trong mã QR di sản: <PUBLIC_BASE_URL>/di-san/<slug>
# Máy dev: http://localhost:5173 · Production: https://duong-sach-project.vercel.app
PUBLIC_BASE_URL="http://localhost:5173"
