{
  "permissions": {
    "allow": [
      "Bash(npm run check)",
      "Bash(npm run seed)",
      "Bash(npm install)",
      "Bash(npx prisma validate)",
      "Bash(npx prisma generate)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Bash(git fetch:*)",
      "Bash(git merge origin/main)",
      "Bash(git push -u origin:*)",
      "Bash(git push)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr list:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git push origin main)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}