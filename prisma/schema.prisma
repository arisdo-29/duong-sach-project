// =====================================================================
// SCHEMA – Đường Sách (đủ 3 phần yêu cầu của mentor)
// Database: SQL Server (local / SSMS). Chỉ trưởng nhóm sửa file này.
//
// Ghi chú:
//  - DATABASE_URL: chuỗi kết nối sqlserver://... (xem .env.example và docs/05).
//  - Trạng thái/mức độ để kiểu String (không dùng enum) → giá trị hợp lệ kiểm tra bằng zod.
//  - Chuỗi dùng NVarChar (Unicode) → tiếng Việt lưu đúng dấu; nội dung dài dùng NVarChar(Max).
//  - id/khóa ngoại là UUID chuỗi 36 ký tự → NVarChar(36).
//  - Model Heritage/Feedback giữ tên field snake_case để khớp frontend đang có.
//    Các model mới dùng camelCase (chuẩn TypeScript).
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// DÙNG CHUNG
// ---------------------------------------------------------------------

/// Cơ sở Đường Sách: HCM (Nguyễn Văn Bình, Q1) và THU_DUC. Dữ liệu seed, chỉ đọc.
model Campus {
  id        String   @id @default(uuid()) @db.NVarChar(36)
  code      String   @unique @db.NVarChar(20)
  name      String   @db.NVarChar(200)
  address   String?  @db.NVarChar(500)
  createdAt DateTime @default(now())

  booths Booth[]
  venues Venue[]

  @@map("campuses")
}

// ---------------------------------------------------------------------
// PHẦN 1 – GIAN HÀNG & CƠ SỞ VẬT CHẤT
// ---------------------------------------------------------------------

/// Gian hàng. Xóa mềm bằng deletedAt (yêu cầu mentor).
model Booth {
  id          String    @id @default(uuid()) @db.NVarChar(36)
  name        String    @db.NVarChar(200)
  campusId    String    @db.NVarChar(36)
  owner       String?   @db.NVarChar(200) // đơn vị: NXB Trẻ, Nhã Nam...
  location    String?   @db.NVarChar(100) // mã/vị trí: "Gian 12"
  description String?   @db.NVarChar(Max)
  bookCount   Int?      // số đầu sách (chờ khách chốt đầu sách hay số bản)
  imageUrl    String?   @db.NVarChar(1000)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  campus Campus @relation(fields: [campusId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([campusId])
  @@index([name])
  @@map("booths")
}

/// Địa điểm tổ chức sự kiện (sân khấu, khu trưng bày...). Đang được dùng thì không cho xóa (409).
model Venue {
  id          String   @id @default(uuid()) @db.NVarChar(36)
  name        String   @db.NVarChar(200)
  campusId    String   @db.NVarChar(36)
  capacity    Int
  description String?  @db.NVarChar(1000)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campus    Campus          @relation(fields: [campusId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  events    Event[]
  proposals EventProposal[]

  @@index([campusId])
  @@map("venues")
}

/// Thiết bị (loa, bàn, ghế, máy chiếu...). Đang được hồ sơ tham chiếu thì không cho xóa (409).
model Asset {
  id            String   @id @default(uuid()) @db.NVarChar(36)
  name          String   @db.NVarChar(200)
  totalQuantity Int
  unit          String?  @db.NVarChar(50)
  description   String?  @db.NVarChar(1000)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  requests ProposalAsset[]

  @@map("assets")
}

// ---------------------------------------------------------------------
// PHẦN 2 – SỰ KIỆN & HỒ SƠ ĐỀ XUẤT
// ---------------------------------------------------------------------

/// Sự kiện đã công bố. importance: NORMAL (Thường) | PRIORITY (Ưu tiên) | KEY (Trọng điểm)
model Event {
  id          String   @id @default(uuid()) @db.NVarChar(36)
  name        String   @db.NVarChar(300)
  startTime   DateTime
  endTime     DateTime
  venueId     String   @db.NVarChar(36)
  description String?  @db.NVarChar(Max)
  importance  String   @default("NORMAL") @db.NVarChar(20)
  proposalId  String?  @db.NVarChar(36) // sự kiện sinh ra từ hồ sơ được duyệt (nếu có); không @unique vì SQL Server coi các NULL là trùng
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  venue    Venue          @relation(fields: [venueId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  proposal EventProposal? @relation(fields: [proposalId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([venueId, startTime])
  @@index([startTime])
  @@map("events")
}

/// Hồ sơ đề xuất tổ chức hoạt động (đăng ký tổ chức, KHÔNG phải vé tham dự).
/// status: PENDING (chờ duyệt) | NEEDS_SUPPLEMENT (trả bổ sung) | APPROVED | REJECTED
model EventProposal {
  id                String    @id @default(uuid()) @db.NVarChar(36)
  title             String    @db.NVarChar(300)
  organizerName     String    @db.NVarChar(200)
  organizerContact  String    @db.NVarChar(200)
  description       String    @db.NVarChar(Max)
  startTime         DateTime
  endTime           DateTime
  venueId           String    @db.NVarChar(36)
  expectedAttendees Int?
  status            String    @default("PENDING") @db.NVarChar(20)
  reviewNote        String?   @db.NVarChar(1000)
  reviewedAt        DateTime?
  submittedAt       DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  venue      Venue               @relation(fields: [venueId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assets     ProposalAsset[]
  reviewLogs ProposalReviewLog[]
  events     Event[]

  @@index([status, submittedAt])
  @@index([startTime])
  @@map("event_proposals")
}

/// Nhu cầu thiết bị của một hồ sơ.
model ProposalAsset {
  proposalId String @db.NVarChar(36)
  assetId    String @db.NVarChar(36)
  quantity   Int

  proposal EventProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  asset    Asset         @relation(fields: [assetId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([proposalId, assetId])
  @@map("proposal_assets")
}

/// Lịch sử duyệt (lưu vết ai làm gì, ghi chú gì). action: APPROVE | REQUEST_SUPPLEMENT | REJECT
model ProposalReviewLog {
  id         String   @id @default(uuid()) @db.NVarChar(36)
  proposalId String   @db.NVarChar(36)
  action     String   @db.NVarChar(30)
  fromStatus String   @db.NVarChar(20)
  toStatus   String   @db.NVarChar(20)
  note       String?  @db.NVarChar(1000)
  createdAt  DateTime @default(now())

  proposal EventProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([proposalId])
  @@map("proposal_review_logs")
}

// ---------------------------------------------------------------------
// PHẦN 3 – DI SẢN & FEEDBACK (giữ tên field cũ để frontend không phải sửa)
// ---------------------------------------------------------------------

/// Di sản. slug cố định (QR đã in). Xóa mềm bằng deleted_at.
model Heritage {
  id         String    @id @default(uuid()) @db.NVarChar(36)
  slug       String    @unique @db.NVarChar(200)
  name_vi    String    @db.NVarChar(300)
  name_en    String    @default("") @db.NVarChar(300)
  content_vi String    @db.NVarChar(Max)
  content_en String    @default("") @db.NVarChar(Max)
  image_url  String    @default("") @db.NVarChar(1000)
  source     String    @default("") @db.NVarChar(500)
  deleted_at DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  feedbacks Feedback[]

  @@map("heritages")
}

/// Góp ý. heritage_id NULL = "Toàn Đường Sách". status: PENDING | REVIEWED | RESOLVED
model Feedback {
  id           String   @id @default(uuid()) @db.NVarChar(36)
  heritage_id  String?  @db.NVarChar(36)
  rating       Int
  content      String   @db.NVarChar(2000)
  status       String   @default("PENDING") @db.NVarChar(20)
  user_contact String?  @db.NVarChar(200)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  heritage Heritage? @relation(fields: [heritage_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([heritage_id])
  @@index([status, created_at])
  @@map("feedbacks")
}
