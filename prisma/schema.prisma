// =====================================================================
// SCHEMA – Đường Sách – SQL SERVER (khuôn mentor, hướng đi 21/09/2026)
// Chỉ trưởng nhóm sửa file này.
//
// 14 bảng (phương án gọn 21/09 – docs/01 ADR-7):
//  - 7 bảng khung nội dung: ItemCategories, Items, ItemAttributes, ItemAttributeMappings,
//    Pictures, ItemPictureMappings, WebsiteAttributes
//  - Proposals + ProposalItems (≈ Orders + OrderItems của khuôn mentor)
//  - 5 bảng nghiệp vụ: Campuses, Venues, Assets, Events, Feedbacks
//
// QUY TẮC ĐẶT TÊN (docs/01 mục 4, theo khuôn mẫu mentor)
//  - Model: PascalCase SỐ ÍT (Item) + @@map("Items") → bảng PascalCase SỐ NHIỀU.
//    Code gọi prisma.item, prisma.itemAttributeMapping...
//  - Cột: PascalCase viết thẳng (Name, NameEng, DateCreated...) → không cần @map.
//  - Khóa chính luôn là Id (UUID dạng chuỗi). Khóa ngoại là <Thực thể>Id.
//  - Tiền tố chủ thể: Item (tương ứng Product của mẫu mentor). Mentor muốn giữ chữ
//    Product thì chỉ đổi tiền tố, cấu trúc giữ nguyên.
//
// QUY TẮC KỸ THUẬT SQL SERVER (bắt buộc – docs/05 mục 7)
//  - Mọi chuỗi dùng @db.NVarChar(n) (KHÔNG dùng VarChar → tiếng Việt thành "?").
//  - Nội dung dài / HTML từ CKEditor: @db.NVarChar(Max) (String mặc định chỉ là nvarchar(1000)).
//  - Không enum, không Json: trạng thái lưu NVarChar + kiểm tra bằng zod.
//  - Mọi quan hệ ghi rõ onDelete: NoAction, onUpdate: NoAction → tránh lỗi
//    "multiple cascade paths" của SQL Server. Xóa dây chuyền (nếu cần) làm trong service
//    bằng prisma.$transaction.
//  - KHÔNG đặt @unique trên cột có thể NULL: SQL Server coi các NULL là trùng nhau,
//    bản ghi thứ hai có NULL sẽ lỗi P2002. Vì vậy Events.ProposalId không unique
//    (quan hệ 1-n, service tự đảm bảo một hồ sơ chỉ sinh một sự kiện).
//
// NGUYÊN TẮC THIẾT KẾ (hướng đi mục 4.1)
//  - Trường dùng để LỌC / SẮP XẾP / KIỂM TRA RÀNG BUỘC → cột thật.
//  - Trường chỉ để HIỂN THỊ và khác nhau theo loại → thuộc tính động
//    (ItemAttributes + ItemAttributeMappings).
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// =====================================================================
// A. KHUNG NỘI DUNG CHUNG (tương ứng mẫu mentor)
// =====================================================================

/// Cơ sở Đường Sách: HCM (Q1) và THU_DUC. Dữ liệu seed, API chỉ đọc.
model Campus {
  Id          String   @id @default(uuid()) @db.NVarChar(36)
  Code        String   @unique @db.NVarChar(20)
  Name        String   @db.NVarChar(200)
  Address     String?  @db.NVarChar(500)
  DateCreated DateTime @default(now())

  Items  Item[]
  Venues Venue[]

  @@map("Campuses")
}

/// Loại nội dung (≈ ProductCategories). Seed: di-san, gian-hang, tien-ich, gioi-thieu.
/// Code tra cứu loại bằng Slug (cố định), không bằng Name.
model ItemCategory {
  Id          String  @id @default(uuid()) @db.NVarChar(36)
  Name        String  @db.NVarChar(200)
  NameEng     String? @db.NVarChar(200)
  Description String? @db.NVarChar(1000)
  Slug        String  @unique @db.NVarChar(100)
  Position    Int     @default(0)
  Notes       String? @db.NVarChar(1000)

  Items      Item[]
  Attributes ItemAttribute[]

  @@map("ItemCategories")
}

/// Nội dung hiển thị cho du khách (≈ Products): di sản, gian hàng, điểm bản đồ, trang giới thiệu.
/// Xóa mềm bằng Deleted. Slug duy nhất; với di sản Slug KHÔNG BAO GIỜ đổi (QR đã in).
model Item {
  Id              String   @id @default(uuid()) @db.NVarChar(36)
  ItemCategoryId  String   @db.NVarChar(36)
  CampusId        String?  @db.NVarChar(36) // cột thật để lọc theo cơ sở; NULL = dùng chung
  Name            String   @db.NVarChar(300)
  NameEng         String   @default("") @db.NVarChar(300)
  Description     String?  @db.NVarChar(1000) // mô tả ngắn (text thường)
  DescEng         String?  @db.NVarChar(1000)
  Content         String   @default("") @db.NVarChar(Max) // HTML từ CKEditor, đã sanitize
  ContentEng      String   @default("") @db.NVarChar(Max)
  Slug            String   @unique @db.NVarChar(200)
  MetaTitle       String?  @db.NVarChar(300)
  MetaKeywords    String?  @db.NVarChar(500)
  MetaDescription String?  @db.NVarChar(1000)
  IsHomePage      Boolean  @default(false)
  DisplayOrder    Int      @default(0)
  Deleted         Boolean  @default(false)
  DateCreated     DateTime @default(now())
  LastEditedTime  DateTime @updatedAt

  ItemCategory      ItemCategory           @relation(fields: [ItemCategoryId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
  Campus            Campus?                @relation(fields: [CampusId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
  AttributeMappings ItemAttributeMapping[]
  PictureMappings   ItemPictureMapping[]
  Feedbacks         Feedback[]

  @@index([ItemCategoryId, Deleted])
  @@index([CampusId])
  @@index([Name])
  @@map("Items")
}

/// Định nghĩa thuộc tính động (≈ ProductAttributes).
/// Code: mã cố định để service tra cứu (vd SOURCE, BOOK_TITLE_COUNT) – bổ sung so với mẫu mentor,
/// vì Name là nhãn hiển thị có thể sửa.
/// ControlType: text | number | textbox | editor | select | date
model ItemAttribute {
  Id             String  @id @default(uuid()) @db.NVarChar(36)
  ItemCategoryId String? @db.NVarChar(36) // thuộc tính dành cho loại nào (NULL = mọi loại)
  Code           String  @unique @db.NVarChar(50)
  Name           String  @db.NVarChar(200)
  NameEng        String? @db.NVarChar(200)
  Description    String? @db.NVarChar(1000)
  ControlType    String  @default("text") @db.NVarChar(30)

  ItemCategory ItemCategory?          @relation(fields: [ItemCategoryId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
  Mappings     ItemAttributeMapping[]

  @@map("ItemAttributes")
}

/// Giá trị thuộc tính của từng Item (≈ ProductAttributeMappings).
/// Ví dụ: số đầu sách, chủ đề, đơn vị sở hữu, vị trí gian hàng; nguồn tư liệu di sản; tọa độ điểm bản đồ.
model ItemAttributeMapping {
  Id              String  @id @default(uuid()) @db.NVarChar(36)
  ItemId          String  @db.NVarChar(36)
  ItemAttributeId String  @db.NVarChar(36)
  Value           String  @default("") @db.NVarChar(Max)
  IsRequired      Boolean @default(false)
  DisplayOrder    Int     @default(0)

  Item          Item          @relation(fields: [ItemId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
  ItemAttribute ItemAttribute @relation(fields: [ItemAttributeId], references: [Id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([ItemId, ItemAttributeId])
  @@map("ItemAttributeMappings")
}

/// Ảnh (≈ Pictures). Ưu tiên lưu Url; Binary để NULL (chưa làm upload trong đợt này).
model Picture {
  Id          String   @id @default(uuid()) @db.NVarChar(36)
  Url         String   @db.NVarChar(1000)
  MimeType    String?  @db.NVarChar(100)
  Description String?  @db.NVarChar(500)
  Binary      Bytes?   @db.VarBinary(Max)
  DateCreated DateTime @default(now())

  ItemMappings ItemPictureMapping[]

  @@map("Pictures")
}

/// Gán ảnh cho Item (≈ ProductPictureMappings). Ảnh đại diện: IsMainPicture = true.
model ItemPictureMapping {
  Id            String  @id @default(uuid()) @db.NVarChar(36)
  ItemId        String  @db.NVarChar(36)
  PictureId     String  @db.NVarChar(36)
  Title         String? @db.NVarChar(300)
  DisplayOrder  Int     @default(0)
  IsMainPicture Boolean @default(false)

  Item    Item    @relation(fields: [ItemId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
  Picture Picture @relation(fields: [PictureId], references: [Id], onDelete: NoAction, onUpdate: NoAction)

  @@index([ItemId])
  @@map("ItemPictureMappings")
}

/// Cấu hình dạng key–value (= WebsiteAttributes của mentor). Name là khóa, duy nhất.
/// Seed: QR_BASE_URL, OPENING_HOURS, HOTLINE, PROPOSAL_MAX_PER_EMAIL_PER_DAY, PROPOSAL_MAX_PER_IP_PER_DAY...
/// Value rỗng = chưa cấu hình (với giới hạn đơn: chưa giới hạn – khách chưa chốt).
model WebsiteAttribute {
  Id             String   @id @default(uuid()) @db.NVarChar(36)
  Name           String   @unique @db.NVarChar(100)
  Description    String?  @db.NVarChar(1000)
  ControlType    String   @default("text") @db.NVarChar(30)
  Type           String   @default("general") @db.NVarChar(50) // nhóm cấu hình: qr, contact, proposal...
  Value          String   @default("") @db.NVarChar(Max)
  IsPublic       Boolean  @default(false) // true = được trả ra API công khai
  Deleted        Boolean  @default(false)
  Text_1         String?  @db.NVarChar(1000)
  Text_2         String?  @db.NVarChar(1000)
  Text_3         String?  @db.NVarChar(1000)
  DateCreated    DateTime @default(now())
  LastEditedTime DateTime @updatedAt

  @@map("WebsiteAttributes")
}

// =====================================================================
// B. BẢNG NGHIỆP VỤ RIÊNG
// =====================================================================

/// Địa điểm tổ chức. Capacity là cột thật để kiểm tra sức chứa.
/// Đang được sự kiện/hồ sơ tham chiếu thì không cho xóa → 409 (P2003).
model Venue {
  Id             String   @id @default(uuid()) @db.NVarChar(36)
  CampusId       String   @db.NVarChar(36)
  Name           String   @db.NVarChar(200)
  Capacity       Int
  Description    String?  @db.NVarChar(1000)
  DateCreated    DateTime @default(now())
  LastEditedTime DateTime @updatedAt

  Campus    Campus     @relation(fields: [CampusId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
  Events    Event[]
  Proposals Proposal[]

  @@index([CampusId])
  @@map("Venues")
}

/// Thiết bị. TotalQuantity là cột thật để kiểm tra thiếu thiết bị.
/// Đang được hồ sơ tham chiếu thì không cho xóa → 409.
model Asset {
  Id             String   @id @default(uuid()) @db.NVarChar(36)
  Name           String   @db.NVarChar(200)
  TotalQuantity  Int
  Unit           String?  @db.NVarChar(50)
  Description    String?  @db.NVarChar(1000)
  DateCreated    DateTime @default(now())
  LastEditedTime DateTime @updatedAt

  ProposalItems ProposalItem[]

  @@map("Assets")
}

/// Sự kiện đã công bố. Importance: NORMAL (Thường) | PRIORITY (Ưu tiên) | KEY (Trọng điểm).
/// ProposalId: hồ sơ sinh ra sự kiện (nếu có). KHÔNG unique vì cột nullable (xem đầu file).
model Event {
  Id             String   @id @default(uuid()) @db.NVarChar(36)
  Name           String   @db.NVarChar(300)
  NameEng        String?  @db.NVarChar(300)
  Description    String?  @db.NVarChar(Max) // HTML từ CKEditor, đã sanitize
  StartTime      DateTime
  EndTime        DateTime
  VenueId        String   @db.NVarChar(36)
  Importance     String   @default("NORMAL") @db.NVarChar(20)
  ProposalId     String?  @db.NVarChar(36)
  DateCreated    DateTime @default(now())
  LastEditedTime DateTime @updatedAt

  Venue    Venue     @relation(fields: [VenueId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
  Proposal Proposal? @relation(fields: [ProposalId], references: [Id], onDelete: NoAction, onUpdate: NoAction)

  @@index([VenueId, StartTime])
  @@index([StartTime])
  @@index([ProposalId])
  @@map("Events")
}

/// Hồ sơ đề xuất tổ chức (≈ Orders) – đăng ký TỔ CHỨC, không phải vé tham dự.
/// Status: PENDING | NEEDS_SUPPLEMENT | APPROVED | REJECTED.
/// Hồ sơ chỉ vào hàng đợi của BQL khi EmailVerifiedAt khác NULL (API admin lọc điều kiện này).
///
/// Thông tin người/đơn vị nộp lưu THẲNG trên hồ sơ (như thông tin người nhận trên Orders),
/// không tách bảng Organizers – mỗi hồ sơ tự đủ thông tin liên hệ. Khi cần hồ sơ tổ chức dùng
/// lại nhiều lần / đăng nhập → tách bảng Organizers sau (ADR-7, docs/01).
/// Duyệt: chỉ lưu lần duyệt GẦN NHẤT (ReviewNote, ReviewedAt, ReviewedBy). Cần lịch sử từng lần
/// → thêm bảng ProposalReviewLogs sau (ADR-7).
model Proposal {
  Id                   String    @id @default(uuid()) @db.NVarChar(36)
  Code                 String    @unique @db.NVarChar(30) // mã tra cứu, vd HS-260922-0001
  // --- Người/đơn vị đề xuất ---
  OrganizerType        String    @db.NVarChar(30) // ca-nhan | doanh-nghiep | truong-hoc | clb-cong-dong (kiểm tra bằng zod)
  OrganizerName        String    @db.NVarChar(300) // tên đơn vị, hoặc họ tên nếu là cá nhân
  RepresentativeName   String?   @db.NVarChar(200) // người đại diện (để trống nếu cá nhân)
  Email                String    @db.NVarChar(254)
  Phone                String?   @db.NVarChar(20)
  TaxCode              String?   @db.NVarChar(20) // mã số thuế – chỉ doanh-nghiep (zod bắt buộc khi OrganizerType = doanh-nghiep)
  // --- Nội dung đề xuất ---
  Title                String    @db.NVarChar(300)
  Description          String    @default("") @db.NVarChar(Max) // HTML từ CKEditor, đã sanitize
  StartTime            DateTime
  EndTime              DateTime
  VenueId              String    @db.NVarChar(36)
  ExpectedAttendees    Int?
  Status               String    @default("PENDING") @db.NVarChar(20)
  ReviewNote           String?   @db.NVarChar(1000) // ghi chú lần duyệt gần nhất (bắt buộc khi trả bổ sung / từ chối)
  ReviewedAt           DateTime?
  ReviewedBy           String?   @db.NVarChar(100) // người duyệt; chưa có đăng nhập thì ghi "admin"
  AccessTokenHash      String?   @db.NVarChar(128) // hash token của link riêng xem trạng thái / nộp bổ sung
  EmailVerifyTokenHash String?   @db.NVarChar(128) // hash mã/link xác nhận email
  EmailVerifyExpiresAt DateTime?
  EmailVerifiedAt      DateTime?
  SubmitterIp          String?   @db.NVarChar(45) // phục vụ giới hạn số đơn theo IP
  DateCreated          DateTime  @default(now())
  LastEditedTime       DateTime  @updatedAt

  Venue  Venue          @relation(fields: [VenueId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
  Items  ProposalItem[]
  Events Event[]

  @@index([Status, DateCreated])
  @@index([StartTime])
  @@index([Email, DateCreated]) // giới hạn số đơn theo email/ngày
  @@index([SubmitterIp, DateCreated]) // giới hạn số đơn theo IP/ngày
  @@map("Proposals")
}

/// Thiết bị xin mượn của một hồ sơ (≈ OrderItems).
model ProposalItem {
  Id         String @id @default(uuid()) @db.NVarChar(36)
  ProposalId String @db.NVarChar(36)
  AssetId    String @db.NVarChar(36)
  Quantity   Int

  Proposal Proposal @relation(fields: [ProposalId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
  Asset    Asset    @relation(fields: [AssetId], references: [Id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([ProposalId, AssetId])
  @@map("ProposalItems")
}

/// Góp ý của du khách. ItemId NULL = "Toàn Đường Sách". Status: PENDING | REVIEWED | RESOLVED.
/// UserContact tùy chọn (privacy by design).
model Feedback {
  Id             String   @id @default(uuid()) @db.NVarChar(36)
  ItemId         String?  @db.NVarChar(36)
  Rating         Int
  Content        String   @db.NVarChar(2000)
  Status         String   @default("PENDING") @db.NVarChar(20)
  UserContact    String?  @db.NVarChar(200)
  DateCreated    DateTime @default(now())
  LastEditedTime DateTime @updatedAt

  Item Item? @relation(fields: [ItemId], references: [Id], onDelete: NoAction, onUpdate: NoAction)

  @@index([ItemId])
  @@index([Status, DateCreated])
  @@map("Feedbacks")
}
